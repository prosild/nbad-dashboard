# compose.portfolio.yml 환경 변수 예시. 복사해서 .env로 쓰고 비밀값을 채운다(이 파일 자체에는 비밀값을 넣지 않는다).
#   cp .env.portfolio.example .env && chmod 600 .env
# 비밀값 생성 예(NAS): openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
# TOTP 시크릿(Base32 32자) 예: openssl rand 20 | base32 | tr -d '=' | head -c 32
# 비밀값이 비어 있으면: PostgreSQL 이미지와 초기화 스크립트가 DB 초기화를 거부하고(앱·API가 뜨지 않음), 시드 스크립트가 실행을 거부한다.

# --- 이미지(로컬 PC에서 빌드해 docker save/load로 옮긴다) ---
PORTFOLIO_APP_IMAGE=zeek-ad-dashboard-app:local
PORTFOLIO_WAF_IMAGE=zeek-ad-dashboard-waf:local
PORTFOLIO_PIPELINE_IMAGE=zeekad-pipeline:dev
PORTFOLIO_POSTGRES_IMAGE=pgvector/pgvector:0.8.1-pg17

# --- 네트워크·공개 경로 ---
# nginx-waf HTTP 포트(127.0.0.1에만 묶임). DSM 역방향 프록시 대상 localhost:<이 포트>. 18080은 같은 NAS의 기존 포트폴리오 컨테이너가 쓴다.
PORTFOLIO_HTTP_PORT=18480
# 공개 호스트 이름(soc.<DDNS 이름>.synology.me). nginx server_name·자체 서명 인증서 이름에만 쓰인다.
PORTFOLIO_SERVER_NAME=soc.example.synology.me
# 스택 고정 서브넷. NAS 기존 Docker 네트워크와 겹치면 바꾼다. 바꾸면 아래 두 주소도 그 서브넷 안으로 바꾼다.
PORTFOLIO_SUBNET=10.203.48.0/24
# T32 nginx-waf 고정 주소. 앱은 이 주소에서 온 연결의 전달 헤더(X-Forwarded-*)만 믿는다.
# 동적 배정(.2부터)과 겹치지 않게 서브넷 끝쪽 주소를 쓴다.
PORTFOLIO_WAF_IP=10.203.48.250
# T32 Docker 게이트웨이 주소(보통 서브넷 첫 주소). DSM이 127.0.0.1:PORTFOLIO_HTTP_PORT로 붙은 연결이 컨테이너 안에서 이 주소로 보인다.
# nginx-waf는 127.0.0.1과 이 주소에서 온 전달 헤더만 믿는다. 반영 전에 docs/portfolio-deployment.md 3.8대로 실제 주소를 확인한다.
PORTFOLIO_GATEWAY_IP=10.203.48.1
# 로그인 속도 제한(POST /api/auth/login, 클라이언트 IP당). 초과 시 429.
PORTFOLIO_LOGIN_RATE=10r/m
PORTFOLIO_LOGIN_BURST=5
# T33 쓰기 속도 제한(분석가 쓰기 네 경로의 POST: 상태 변경·담당 지정·검토 결정 둘, 클라이언트 IP당, 로그인 제한과 따로). 초과 시 429.
PORTFOLIO_WRITE_RATE=10r/m
PORTFOLIO_WRITE_BURST=5
# 계정 잠금(T29·T33): compose.portfolio.yml이 5회·15분으로 고정하고 공개 계정 demo·trial-analyst만 잠금에서 뺀다
# (DASHBOARD_LOCKOUT_EXEMPT_USERNAMES, 기본 demo,trial-analyst. 지금 역할이 VIEWER·ANALYST일 때만 빠지고 ADMIN은 늘 잠긴다).
# 목록에는 비밀번호를 공개한 공유 계정만 넣는다. 실제 분석가 이름을 넣으면 그 계정도 잠기지 않는다.
# T23 기준 시각(앱 DASHBOARD_TIME_ANCHOR). 공개 데모는 고정 스냅샷이라 latest-data(데이터 최신 시각 기준, 비워 두면 이 값).
# now(서버 현재 시각)로 바꾸면 "최근 24시간" 목록이 늘 비어 보인다. 다른 값이면 앱이 시작하지 않는다.
PORTFOLIO_TIME_ANCHOR=latest-data
# T25 착수 목표(DASHBOARD_SLA_ACK_HIGH·MEDIUM·LOW)는 compose.portfolio.yml이 넘기지 않아 앱 기본값(30m·4h·24h)을 쓴다. 공개 데모는 고정 스냅샷이라 기준 시각 기준으로 센다.
# T24 센서 상태 기준은 앱 기본값(정상 15분·중단 1시간, 기준 시각 기준)을 쓴다. compose.portfolio.yml은 넘기지 않는다.

# --- 스냅샷(scripts/portfolio-snapshot.ps1 결과: zeekad.dump, zeekad.dump.sha256, manifest.json) ---
PORTFOLIO_SNAPSHOT_DIR=./snapshot

# --- DB 비밀번호(비밀값) ---
POSTGRES_SUPERUSER_PASSWORD=
ZEEKAD_API_PASSWORD=
DASHBOARD_RO_PASSWORD=
DASHBOARD_RW_PASSWORD=
DASHBOARD_APP_PASSWORD=

# --- 계정(비밀값) ---
# 공개 데모 계정 demo의 비밀번호. 포트폴리오 글에 공개하는 값이지만 저장소에는 넣지 않는다.
DEMO_PASSWORD=
DEMO_DISPLAY_NAME=포트폴리오 방문자 (읽기 전용)
# demo 허용 캡처(쉼표 구분, 예: cic17-*,syn1-*,lab-20261119). 비워 두면 시드 스크립트 기본값 cic17-*,syn1-*,lab-20261119
# (Kali 실습망 lab-20261119만 정확한 ID로 공개. 시험 캡처 lab-20261201·첫 VM 실행 lab-20261118은 시연에서 숨김).
DEMO_CAPTURE_PATTERNS=
# T33 체험용 분석가 계정 trial-analyst(ANALYST, 허용 캡처는 demo와 같음)의 비밀번호. demo처럼 포트폴리오 글에 공개하는 값이지만
# 저장소에는 넣지 않는다. 비워 두면 시드가 이 계정을 만들지 않는다(이미 있으면 비활성). 바꾼 내용은 sandbox-reset이 매시 정각에 되돌린다.
TRIAL_ANALYST_PASSWORD=
TRIAL_ANALYST_DISPLAY_NAME=포트폴리오 방문자 (분석가 체험)
# 비활성으로 둘 부트스트랩 계정. 서로 다른 비공개 무작위 값.
BOOTSTRAP_VIEWER1_PASSWORD=
BOOTSTRAP_ANALYST1_PASSWORD=
BOOTSTRAP_ANALYST2_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
# admin TOTP 시크릿(Base32). 시드 스크립트가 이 값으로 TOTP 코드를 계산해 관리자 API를 쓴다.
BOOTSTRAP_ADMIN_TOTP_SECRET=

# --- 체험 계정 초기화(T33, 비밀값) ---
# 초기화 전용 DB 계정 zeekad_sandbox_reset의 비밀번호(sandbox-setup이 역할을 만들고 sandbox-reset이 접속한다). NAS에서 무작위로 만든다.
SANDBOX_RESET_DB_PASSWORD=
# 초기화 주기(분). 60 = 매시 정각(UTC·KST 모두 정각). 리허설만 1로 줄인다.
SANDBOX_RESET_INTERVAL_MINUTES=60
