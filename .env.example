# zeek_ad_dashboard 환경 변수 예시 (.env로 복사한 뒤 실제 값으로 교체하세요. 실제 비밀값은 Git에 커밋하지 마세요.)

# 대시보드 자체 PostgreSQL (zeekad_dashboard)
DASHBOARD_DB_HOST=host.docker.internal
DASHBOARD_DB_PORT=55432
DASHBOARD_DB_NAME=zeekad_dashboard
DASHBOARD_DB_USER=dashboard_app
DASHBOARD_APP_PASSWORD=<CHANGE_ME_DASHBOARD_APP_PASSWORD>

# zeek_AD PostgreSQL (zeekad: 읽기 전용 + 상태 전이 함수 전용)
ZEEKAD_DB_HOST=host.docker.internal
ZEEKAD_DB_PORT=55432
ZEEKAD_DB_NAME=zeekad
ZEEKAD_RO_USER=dashboard_ro
ZEEKAD_RO_PASSWORD=<CHANGE_ME_ZEEKAD_RO_PASSWORD>
ZEEKAD_RW_USER=dashboard_rw
ZEEKAD_RW_PASSWORD=<CHANGE_ME_ZEEKAD_RW_PASSWORD>

# 사건 상세 근거 FastAPI (evidence.v1)
ZEEKAD_EVIDENCE_API_URL=http://host.docker.internal:8000

# 쿠키 및 세션 보안 설정 (HTTPS 앞단 WAF 사용 시 반드시 true 유지)
DASHBOARD_COOKIE_SECURE=true
DASHBOARD_SESSION_IDLE_TIMEOUT=30m
DASHBOARD_MAX_FAILED_ATTEMPTS=5
DASHBOARD_LOCKOUT_MINUTES=15
DASHBOARD_IDLE_TIMEOUT_MINUTES=30
DASHBOARD_ABSOLUTE_TIMEOUT_MINUTES=480

# 최초 기동 시 users 테이블이 비어 있을 때만 사용되는 부트스트랩 비밀번호/시크릿
# 초기 배포 완료 후에는 비워 두거나 제거하는 것을 권장합니다.
DASHBOARD_BOOTSTRAP_PASSWORD=
BOOTSTRAP_VIEWER1_PASSWORD=
BOOTSTRAP_ANALYST1_PASSWORD=
BOOTSTRAP_ANALYST2_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=

# 앞단 Nginx + ModSecurity WAF 포트 및 서버명
WAF_HTTP_PORT=8080
WAF_HTTPS_PORT=8443
WAF_SERVER_NAME=localhost
