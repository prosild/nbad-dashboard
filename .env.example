# zeek_ad_dashboard 환경 변수 예시 (.env로 복사한 뒤 실제 값으로 교체하세요. 실제 비밀값은 Git에 커밋하지 마세요.)
#
# [환경 구분 안내]
# 1) VMware Ubuntu Server 단일 VM 통합 Docker Compose 배포 (기본):
#    - zeek_AD Compose 서비스명 예시: postgres:5432, http://evidence-api:8000 (환경에 맞게 서비스명 조정)
#    - WAF 포트: 80 / 443, Windows 브라우저에서 https://<VM_IP> 접속
# 2) 로컬 개발 환경(bootRun 또는 호스트 PostgreSQL 직접 연결):
#    - Spring application.yml 기본값: 127.0.0.1:55432, http://127.0.0.1:8000
#    - 컨테이너에서 호스트 PG17/FastAPI 접속 시: host.docker.internal / 55432, http://host.docker.internal:8000

# 1. 대시보드 자체 PostgreSQL (zeekad_dashboard)
DASHBOARD_DB_HOST=postgres
DASHBOARD_DB_PORT=5432
DASHBOARD_DB_NAME=zeekad_dashboard
DASHBOARD_DB_USER=dashboard_app
DASHBOARD_APP_PASSWORD=<CHANGE_ME_DASHBOARD_APP_PASSWORD>

# 2. zeek_AD PostgreSQL (zeekad: 읽기 전용 + 상태 전이 함수 전용)
ZEEKAD_DB_HOST=postgres
ZEEKAD_DB_PORT=5432
ZEEKAD_DB_NAME=zeekad
ZEEKAD_RO_USER=dashboard_ro
ZEEKAD_RO_PASSWORD=<CHANGE_ME_ZEEKAD_RO_PASSWORD>
ZEEKAD_RW_USER=dashboard_rw
ZEEKAD_RW_PASSWORD=<CHANGE_ME_ZEEKAD_RW_PASSWORD>

# 3. 사건 상세 근거 FastAPI (evidence.v1)
ZEEKAD_EVIDENCE_API_URL=http://evidence-api:8000

# 4. 쿠키 및 세션·로그인 보안 설정 (HTTPS 앞단 WAF 사용 시 DASHBOARD_COOKIE_SECURE=true 유지)
DASHBOARD_COOKIE_SECURE=true
DASHBOARD_SESSION_IDLE_TIMEOUT=30m
DASHBOARD_MAX_FAILED_ATTEMPTS=5
DASHBOARD_LOCKOUT_MINUTES=15
DASHBOARD_IDLE_TIMEOUT_MINUTES=30
DASHBOARD_ABSOLUTE_TIMEOUT_MINUTES=480

# 5. 최초 기동 시 users 테이블이 비어 있을 때만 사용되는 부트스트랩 비밀번호/시크릿
# 초기 배포 및 계정 설정 완료 후에는 비워 두거나 제거하는 것을 권장합니다.
DASHBOARD_BOOTSTRAP_PASSWORD=
BOOTSTRAP_VIEWER1_PASSWORD=
BOOTSTRAP_ANALYST1_PASSWORD=
BOOTSTRAP_ANALYST2_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=

# 6. 앞단 Nginx + ModSecurity WAF 포트·호스트·TLS 인증서 설정
WAF_HTTP_PORT=80
WAF_HTTPS_PORT=443
# 배포 VM IP 또는 도메인(예: 192.168.56.10). 미지정 시 localhost
WAF_SERVER_NAME=localhost
SERVER_NAME=localhost
SSL_REDIRECT_PORT=443
# 백엔드로 전달할 Host 헤더 (기본값 $http_host; compose.yml에서는 $$http_host)
# PROXY_HOST_HEADER=$http_host
# VM IP SAN이 포함된 자체 서명/사내 인증서를 ./docker/certs/에 배치할 경우 아래 경로로 지정하세요.
# (기본값: 컨테이너 기동 시 자동 생성되는 /etc/nginx/conf/server.crt, server.key)
SSL_CERT_FILE=/etc/nginx/conf/server.crt
SSL_CERT_KEY_FILE=/etc/nginx/conf/server.key
