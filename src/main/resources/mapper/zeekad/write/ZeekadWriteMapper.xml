<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeekad.dashboard.mapper.zeekad.write.ZeekadWriteMapper">

    <select id="transitionIncident" resultType="string" databaseId="postgresql">
        SELECT dashboard.transition_incident(
            p_job => #{jobId,jdbcType=BIGINT},
            p_incident => #{incidentId,jdbcType=VARCHAR},
            p_to => #{toStatus,jdbcType=VARCHAR},
            p_actor => #{loginUser,jdbcType=VARCHAR},
            p_reason => #{reason,jdbcType=VARCHAR},
            p_resolution => #{resolution,jdbcType=VARCHAR}
        )
    </select>

    <select id="transitionIncident" resultType="string" databaseId="h2">
        SELECT dashboard.transition_incident(
            #{jobId,jdbcType=BIGINT},
            #{incidentId,jdbcType=VARCHAR},
            #{toStatus,jdbcType=VARCHAR},
            #{loginUser,jdbcType=VARCHAR},
            #{reason,jdbcType=VARCHAR},
            #{resolution,jdbcType=VARCHAR}
        )
    </select>

    <select id="decideReview" resultType="string" databaseId="postgresql">
        SELECT dashboard.decide_review(
            p_job => #{jobId,jdbcType=BIGINT},
            p_incident => #{incidentId,jdbcType=VARCHAR},
            p_action => #{action,jdbcType=VARCHAR},
            p_analyst => #{analyst,jdbcType=VARCHAR},
            p_note => #{note,jdbcType=VARCHAR}
        )
    </select>

    <select id="decideReview" resultType="string" databaseId="h2">
        SELECT dashboard.decide_review(
            #{jobId,jdbcType=BIGINT},
            #{incidentId,jdbcType=VARCHAR},
            #{action,jdbcType=VARCHAR},
            #{analyst,jdbcType=VARCHAR},
            #{note,jdbcType=VARCHAR}
        )
    </select>

    <!-- T53 다시 열기: zeek_AD migration 018의 dashboard.reopen_incident(p_job, p_incident, p_actor, p_reason, p_expected_resolution).
         이름 인자가 함수와 어긋나면 42883(함수 없음)이라 서비스가 501로 보인다. 실제 함수로 한 성공 확인이 이것을 막는다. -->
    <select id="reopenIncident" resultType="string" databaseId="postgresql">
        SELECT dashboard.reopen_incident(
            p_job => #{jobId,jdbcType=BIGINT},
            p_incident => #{incidentId,jdbcType=VARCHAR},
            p_actor => #{loginUser,jdbcType=VARCHAR},
            p_reason => #{reason,jdbcType=VARCHAR},
            p_expected_resolution => #{expectedResolution,jdbcType=VARCHAR}
        )
    </select>

    <select id="reopenIncident" resultType="string" databaseId="h2">
        SELECT dashboard.reopen_incident(
            #{jobId,jdbcType=BIGINT},
            #{incidentId,jdbcType=VARCHAR},
            #{loginUser,jdbcType=VARCHAR},
            #{reason,jdbcType=VARCHAR},
            #{expectedResolution,jdbcType=VARCHAR}
        )
    </select>

</mapper>
